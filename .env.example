# Copy to .env and change the secrets. Every variable has a safe default in docker-compose.yml.

# Organizer simulator (live world)
SIMULATION_SPEED=2
TICK_MINUTES=15
SIMULATOR_START_MODE=running

# Operator access (sent as X-Operator-Token / X-Admin-Token headers from the UI)
OPERATOR_TOKEN=change-me-operator
ADMIN_TOKEN=change-me-admin

# Decision policy
AUTONOMY_MODE=SUPERVISED
PLAN_HORIZON_TICKS=48
SAFETY_Z=1.28
CONSTRAINED_FACTOR=0.5

# Optional: Azure OpenAI for plain-language explanations (templates are used when empty)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Observability
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports
WEB_PORT=8080
BACKEND_PORT=8081
SIM_PORT=8000
SIM_LAB_PORT=8001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Shown in the UI and /api/status
GIT_SHA=dev
